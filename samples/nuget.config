<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- The library's own packages come from those its gate packed from this commit, every other package from nuget.org (07 MSG-ENG-001). -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="packed" value="../artifacts/packages" />
  </packageSources>

  <packageSourceMapping>
    <clear />
    <packageSource key="packed">
      <package pattern="Hermes" />
      <package pattern="Hermes.Core" />
      <package pattern="Hermes.Channels" />
      <package pattern="Hermes.Testing" />
      <package pattern="Hermes.Cli" />
      <package pattern="Hermes.Development" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
