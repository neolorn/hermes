<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The sending engine: kinds, the outbox, the checks, dispatch, templates, the endpoints, the schema</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Fluid.Core" />
  </ItemGroup>

  <ItemGroup>
    <!-- The library's own pages, found as a host assembly's resource is, by their path under the template folder (03 MSG-TPL-006). -->
    <EmbeddedResource Include="Content\*.liquid" LogicalName="pages/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hermes.Core\Hermes.Core.csproj" />
    <ProjectReference Include="..\Hermes.Channels\Hermes.Channels.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hermes.Tests" />
    <InternalsVisibleTo Include="Hermes.Cli" />
    <InternalsVisibleTo Include="Hermes.Testing" />
  </ItemGroup>

</Project>
