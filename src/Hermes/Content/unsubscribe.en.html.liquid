<!DOCTYPE html>
<html lang="{{ language }}" dir="{{ direction }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Unsubscribe</title>
<style>body{font-family:system-ui,sans-serif;max-width:32rem;margin:3rem auto;padding:0 1rem;line-height:1.5}button{font:inherit;padding:.5rem 1rem}</style>
</head>
<body>
<h1>Unsubscribe</h1>
<p>Stop receiving {{ category }} messages at this address?</p>
<form method="post" action="{{ action }}">
<input type="hidden" name="page" value="unsubscribe">
<button type="submit">Unsubscribe</button>
</form>
</body>
</html>
